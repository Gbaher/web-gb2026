{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/case-sofia",           "destination": "/case-sofia.html" },
    { "source": "/case-alalay",          "destination": "/case-alalay.html" },
    { "source": "/case-bodega",          "destination": "/case-bodega.html" },
    { "source": "/brand-intelligence",   "destination": "/brand-intelligence.html" },
    { "source": "/brand-intelligence-inteligencia-de-marca", "destination": "/brand-intelligence-inteligencia-de-marca.html" },
    { "source": "/bi-001-logo-vs-marca", "destination": "/bi-001-logo-vs-marca.html" },
    { "source": "/portal",               "destination": "/portal.html" },
    { "source": "/propuesta-demo",        "destination": "/propuesta-demo.html" },
    { "source": "/propuesta-sallkof",    "destination": "/propuesta-sallkof.html" }
  ],
  "redirects": [
    { "source": "/case-sofia.html",           "destination": "/case-sofia",           "permanent": true },
    { "source": "/case-alalay.html",          "destination": "/case-alalay",          "permanent": true },
    { "source": "/case-bodega.html",          "destination": "/case-bodega",          "permanent": true },
    { "source": "/brand-intelligence.html",   "destination": "/brand-intelligence",   "permanent": true },
    { "source": "/brand-intelligence-inteligencia-de-marca.html", "destination": "/brand-intelligence-inteligencia-de-marca", "permanent": true },
    { "source": "/bi-001-logo-vs-marca.html", "destination": "/bi-001-logo-vs-marca", "permanent": true },
    { "source": "/portal.html",               "destination": "/portal",               "permanent": true },
    { "source": "/propuesta-demo.html",       "destination": "/propuesta-demo",       "permanent": true },
    { "source": "/propuesta-sallkof.html",   "destination": "/propuesta-sallkof",   "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://*.googleapis.com https://api.brevo.com https://ipapi.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://script.google.com https://script.googleusercontent.com;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://germanbaher.com"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
